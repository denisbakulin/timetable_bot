TOKEN="токен бота"

ADMIN_CHAT_ID="id админского чата для фидбека (начинается с -rcp)"

FEEDBACK_THREAD_ID="id треда для ответов"


TIMETABLE_URL="https://timetable.pallada.sibsau.ru/timetable" #url для парсинга
TIMETABLE_PROXY="" #опционально. Пример: http://user:pass@ru-proxy-host:port

TIMETABLE_UPDATE_TIME_SECONDS=10800 #количество секунд хранения расписания в кеше

# optional redis cache (can be empty to run without redis)
CACHE_URL="redis://localhost:6379/0"
# CACHE_PORT is no longer used; keep for backward compatibility if you have it in your .env
CACHE_PORT=6379

# optional redis storage for aiogram FSM (if empty -> MemoryStorage)
FSM_REDIS_URL="redis://localhost:6379/1"
